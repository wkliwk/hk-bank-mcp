{
  "name": "hkma-mcp",
  "version": "0.1.0",
  "description": "MCP server for the official HKMA Open API \u2014 Hong Kong bank ATM/branch search, HIBOR and HKD interest rates. No credentials, no scraping.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hkma",
    "hong-kong-monetary-authority",
    "hong-kong",
    "hibor",
    "banking",
    "open-data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkliwk/hkma-mcp.git"
  },
  "homepage": "https://github.com/wkliwk/hkma-mcp#readme",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hkma-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && chmod +x dist/index.js",
    "build:publish": "node scripts/bundle.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hkma-mcp/hkma-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
