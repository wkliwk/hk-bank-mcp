{
  "name": "@wkliwk/hk-bank-mcp",
  "version": "0.1.0",
  "description": "MCP server for Hong Kong banking data — HKMA public APIs, no credentials, no scraping",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hong-kong",
    "hkma",
    "banking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkliwk/hk-bank-mcp.git"
  },
  "homepage": "https://github.com/wkliwk/hk-bank-mcp#readme",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hk-bank-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && chmod +x dist/index.js",
    "build:publish": "node scripts/bundle.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hk-bank-mcp/hkma-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
